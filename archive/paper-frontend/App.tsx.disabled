import { createEffect, createMemo, createSignal, For, Match, onCleanup, onMount, Show, Switch, type JSX } from 'solid-js';
import type { BotConfig, BotState, Book, Candle, FundingPoint, Health, Leaderboard, Market, OrderInput, Overview, PaperAccount, Snapshot, Trade } from '../shared/contracts';
import { mutate, num, pct, price, request, session, shortAddress, stamp, usd, useSnapshot } from './api';
import { Asset, Badge, Empty, ErrorLine, Icon, Logo, Panel, Segmented, Source, Sparkline } from './ui';
import { axisStyle, Chart, chartGrid } from './Chart';
import { LivePanel } from './LivePanel';
import { openPublicStream } from '../shared/public-stream';
import { estimateOrder } from '../trading/math';

type Page = 'overview' | 'markets' | 'terminal' | 'funding' | 'leaderboard' | 'bots' | 'system';
const NAV: { id: Page; name: string; detail: string; icon: string }[] = [
  { id: 'overview', name: 'Overview', detail: 'The market, at a glance', icon: 'overview' },
  { id: 'markets', name: 'Markets', detail: 'Discover opportunities', icon: 'markets' },
  { id: 'terminal', name: 'Terminal', detail: 'Your execution workspace', icon: 'terminal' },
  { id: 'funding', name: 'Funding', detail: 'The cost of conviction', icon: 'funding' },
  { id: 'leaderboard', name: 'Leaderboard', detail: 'Follow performance', icon: 'leaderboard' },
  { id: 'bots', name: 'Automations', detail: 'Strategies on your terms', icon: 'bots' },
  { id: 'system', name: 'System', detail: 'Sources & connectivity', icon: 'system' },
];
const COLORS = ['#c8f575', '#80cbbd', '#9e9ae7', '#d9aa72', '#769cb5', '#cf86a9'];
const changeClass = (n: number | null | undefined) => n === null || n === undefined ? '' : n >= 0 ? 'positive' : 'negative';
const getPage = (): Page => NAV.some(n => n.id === location.hash.slice(1)) ? location.hash.slice(1) as Page : 'overview';

export default function App() {
  const [page, setPage] = createSignal<Page>(getPage());
  const [menuOpen, setMenuOpen] = createSignal(false);
  const [selectedId, setSelectedId] = createSignal<number | null>(null);
  const [now, setNow] = createSignal(Date.now());
  const markets = useSnapshot<Market[]>(() => '/api/markets', 12_000);
  const [health, setHealth] = createSignal<Health | null>(null);
  const [healthError, setHealthError] = createSignal<string | null>(null);
  const [paper, setPaper] = createSignal<PaperAccount | null>(null);
  const [paperError, setPaperError] = createSignal<string | null>(null);
  const selected = createMemo(() => markets.data()?.find(m => m.id === selectedId()) ?? markets.data()?.find(m => m.baseAsset === 'BTC') ?? markets.data()?.[0] ?? null);
  const loadPaper = async () => { try { setPaper(await request<PaperAccount>('/api/paper')); setPaperError(null); } catch (e) { setPaperError((e as Error).message); } };
  const loadHealth = async () => { try { setHealth(await request<Health>('/api/health')); setHealthError(null); } catch (e) { setHealthError((e as Error).message); } };
  const navigate = (next: Page) => { location.hash = next; setPage(next); setMenuOpen(false); window.scrollTo(0, 0); };
  const openMarket = (m: Market) => { setSelectedId(m.id); navigate('terminal'); };
  onMount(() => {
    const change = () => { setPage(getPage()); setMenuOpen(false); };
    addEventListener('hashchange', change);
    void loadHealth(); void loadPaper();
    const timer = setInterval(() => { setNow(Date.now()); }, 1_000);
    const accountTimer = setInterval(() => { void loadPaper(); }, 10_000);
    const healthTimer = setInterval(() => { void loadHealth(); }, 30_000);
    onCleanup(() => { removeEventListener('hashchange', change); clearInterval(timer); clearInterval(accountTimer); clearInterval(healthTimer); });
  });
  createEffect(() => { document.title = `${NAV.find(n => n.id === page())?.name} | PolyTrade`; });
  return <div class="app-shell">
    <Show when={menuOpen()}><button class="sidebar-scrim" onClick={() => setMenuOpen(false)} aria-label="Close navigation"/></Show>
    <aside classList={{ sidebar: true, open: menuOpen() }}>
      <a class="brand-link" href="#overview" onClick={() => navigate('overview')} aria-label="PolyTrade overview"><Logo/></a>
      <div class="workspace-selector"><span class="workspace-square">P</span><div><strong>Polymarket Perps</strong><small>Independent workspace</small></div><span class="tiny-dot"/></div>
      <div class="nav-caption">WORKSPACE</div>
      <nav aria-label="Main navigation"><For each={NAV}>{(item, i) => <><Show when={i() === 5}><div class="nav-caption secondary-caption">OPERATIONS</div></Show><a href={`#${item.id}`} classList={{ 'nav-item': true, active: page() === item.id }} onClick={e => { e.preventDefault(); navigate(item.id); }}><Icon name={item.icon}/><span>{item.name}</span><Show when={page() === item.id}><span class="nav-active-dot"/></Show><Show when={item.id === 'bots'}><span class="nav-tag">PAPER</span></Show></a></>}</For></nav>
      <div class="sidebar-bottom"><div class="connection-card"><div><span class={`status-dot ${health() ? 'live' : 'unavailable'}`}/><span>Local workspace</span><Icon name="system" size={15}/></div><small>{health() ? 'Service connected' : 'Connecting to service…'}</small><div class="connection-bars"><i/><i/><i/><i/><i/><i/><i/><i/><i/><i/><i/><i/><i/><i/><i/><i/></div></div><a href="https://docs.polymarket.com/perps/overview" target="_blank" rel="noreferrer" class="docs-link"><Icon name="link" size={15}/>Exchange documentation<Icon name="arrow" size={13}/></a><div class="byline">BUILT BY <strong>TEMPLARS</strong><span>v0.1</span></div></div>
    </aside>
    <div class="workspace-main">
      <header class="topbar"><div class="topbar-breadcrumb"><button class="icon-button mobile-menu" onClick={() => setMenuOpen(!menuOpen())} aria-label="Open navigation"><Icon name="menu"/></button><span class="breadcrumb-root">Workspace</span><Icon name="chevron" size={12}/><strong>{NAV.find(n => n.id === page())?.name}</strong></div><div class="topbar-actions"><span class="utc-clock">{new Date(now()).toLocaleTimeString('en-GB', { timeZone: 'UTC' })}<span> UTC</span></span><span class="network-badge"><span class={`status-dot ${markets.snapshot()?.status ?? 'unavailable'}`}/>MAINNET DATA</span><button class="wallet-button" onClick={() => navigate('terminal')}><Icon name="wallet" size={16}/><span>Open terminal</span><Icon name="arrow" size={13}/></button></div></header>
      <div class="market-ribbon"><span class="ribbon-label"><span class={`status-dot ${markets.snapshot()?.status ?? 'unavailable'}`}/>MARKET PULSE</span><Show when={markets.data()?.length} fallback={<span class="muted">Official market observations loading…</span>}><For each={markets.data()?.slice(0, 5)}>{m => <button onClick={() => openMarket(m)}><strong>{m.baseAsset}</strong><span>{price(m.markPrice)}</span><span class={changeClass(m.change24h)}>{pct(m.change24h)}</span></button>}</For></Show></div>
      <main classList={{ 'content': true, 'terminal-content': page() === 'terminal' }}>
        <Switch>
          <Match when={page() === 'overview'}><OverviewPage markets={markets.data() ?? []} snapshot={markets.snapshot()} onMarket={openMarket} goMarkets={() => navigate('markets')}/></Match>
          <Match when={page() === 'markets'}><MarketsPage markets={markets.data() ?? []} snapshot={markets.snapshot()} error={markets.error()} loading={markets.loading()} onMarket={openMarket}/></Match>
          <Match when={page() === 'terminal'}><TerminalPage market={selected()} markets={markets.data() ?? []} marketSnapshot={markets.snapshot()} onSelect={setSelectedId} paper={paper()} setPaper={setPaper} reloadPaper={loadPaper} paperError={paperError()} liveEnabled={health()?.liveEnabled ?? false}/></Match>
          <Match when={page() === 'funding'}><FundingPage markets={markets.data() ?? []} snapshot={markets.snapshot()} onMarket={openMarket}/></Match>
          <Match when={page() === 'leaderboard'}><LeaderboardPage/></Match>
          <Match when={page() === 'bots'}><BotsPage markets={markets.data() ?? []} paper={paper()} setPaper={setPaper}/></Match>
          <Match when={page() === 'system'}><SystemPage health={health()} error={healthError()} marketSnapshot={markets.snapshot()} refresh={() => { void loadHealth(); void markets.refresh(); }}/></Match>
        </Switch>
      </main>
      <footer class="workspace-footer"><span><span class={`status-dot ${health() ? 'live' : 'unavailable'}`}/> POLYTRADE <span class="footer-divider">/</span> Independent analytics for Polymarket Perps</span><span>Official observations. Transparent coverage.<a href="https://polymarket.com/perps" target="_blank" rel="noreferrer">Open exchange <Icon name="arrow" size={11}/></a></span></footer>
    </div>
  </div>;
}

function PageHeader(p: { eyebrow: string; title: string; description: string; children?: JSX.Element }) { return <div class="page-header"><div><div class="eyebrow"><span class="eyebrow-line"/>{p.eyebrow}</div><h1>{p.title}</h1><p>{p.description}</p></div><div class="page-header-actions">{p.children}</div></div>; }
function StatCard(p: { label: string; value: string; detail: string; icon: string; accent?: boolean; extra?: JSX.Element }) { return <div class={`stat-card ${p.accent ? 'accent-card' : ''}`}><div class="stat-label">{p.label}<Icon name={p.icon} size={17}/></div><div class="stat-value">{p.value}</div><div class="stat-detail">{p.extra}{p.detail}</div></div>; }
function MarketTable(p: { markets: Market[]; onMarket: (m: Market) => void; loading?: boolean; compact?: boolean }) {
  return <div class="table-scroll"><table class={`market-table ${p.compact ? 'compact-table' : ''}`}><thead><tr><th>Market</th><th>Mark price</th><th>24h change</th><th>24h volume</th><th>Open interest</th><th>Funding / interval</th><th>Price history</th><th aria-label="Open terminal"/></tr></thead><tbody><For each={p.markets} fallback={<tr><td colspan="8"><Empty loading={p.loading} text="No markets match this view."/></td></tr>}>{m => <tr tabindex="0" onClick={() => p.onMarket(m)} onKeyDown={e => { if (e.key === 'Enter') p.onMarket(m); }} aria-label={`Open ${m.displaySymbol} terminal`}><td><div class="market-name"><Asset symbol={m.baseAsset}/><div><strong>{m.displaySymbol}</strong><small>{m.category}<Show when={m.closeOnly || m.settled}> · {m.settled ? 'Settled' : 'Close only'}</Show></small></div><Badge>{m.maxLeverage}×</Badge></div></td><td class="mono price-cell">{price(m.markPrice)}</td><td class={`mono ${changeClass(m.change24h)}`}>{pct(m.change24h)}</td><td class="mono">{usd(m.volume24h, true)}</td><td class="mono">{usd(m.openInterestUsd, true)}</td><td><span class={`mono ${changeClass(m.fundingRate)}`}>{pct(m.fundingRate, 4)}</span><small>{m.fundingIntervalHours === null ? 'Interval unavailable' : `every ${m.fundingIntervalHours}h`}</small></td><td><Sparkline values={m.sparkline} positive={(m.change24h ?? 0) >= 0}/></td><td><button class="row-arrow" onClick={e => { e.stopPropagation(); p.onMarket(m); }} aria-label={`Trade ${m.displaySymbol}`}><Icon name="arrow" size={15}/></button></td></tr>}</For></tbody></table></div>;
}

function OverviewPage(p: { markets: Market[]; snapshot: Snapshot<Market[]> | null; onMarket: (m: Market) => void; goMarkets: () => void }) {
  const overview = useSnapshot<Overview>(() => '/api/overview', 15_000);
  const categories = createMemo(() => overview.data()?.categories.filter(c => c.volume > 0) ?? []);
  const largest = createMemo(() => [...p.markets].sort((a, b) => (b.volume24h ?? -1) - (a.volume24h ?? -1)).slice(0, 7));
  const movers = createMemo(() => p.markets.filter(m => m.change24h !== null).sort((a, b) => Math.abs(b.change24h!) - Math.abs(a.change24h!)).slice(0, 3));
  return <><PageHeader eyebrow="THE BIG PICTURE" title="Market overview" description="A clear view of perpetual markets. Every number, from the source."><Badge tone="mint"><span class={`status-dot ${overview.snapshot()?.status ?? 'unavailable'}`}/>{overview.snapshot()?.status === 'live' ? 'Live market data' : 'Source status'} </Badge><button class="button subtle" onClick={() => { void overview.refresh(); }} aria-label="Refresh overview"><Icon name="refresh" size={15}/>Refresh</button></PageHeader>
    <div class="stats-grid"><StatCard label="24H TRADING VOLUME" value={usd(overview.data()?.volume24h, true)} detail={`${overview.data()?.volumeCoverage ?? 0} / ${overview.data()?.markets ?? 0} markets reporting`} icon="markets" accent/><StatCard label="OPEN INTEREST" value={usd(overview.data()?.openInterestUsd, true)} detail="One-sided notional · mark conversion" icon="funding"/><StatCard label="ACTIVE MARKETS" value={overview.data() ? num(overview.data()!.markets, 0) : 'Unavailable'} detail={`${new Set(p.markets.map(m => m.category)).size} observed asset categories`} icon="overview"/><StatCard label="24H EXCHANGE FEES" value={usd(overview.data()?.fees24h, true)} detail="Gross positive fees · excludes rebates/referrals" icon="wallet"/></div>
    <ErrorLine error={overview.error()}/>
    <div class="overview-middle"><Panel title="Volume by category" eyebrow="MARKET COMPOSITION" action={<span class="small muted">Rolling 24 hours</span>} class="category-panel"><Show when={categories().length} fallback={<Empty loading={overview.loading()} text="Category volume is not available from the source."/>}><div class="category-chart"><div class="donut-wrap"><Chart height={240} label="Official 24-hour volume by asset category" option={() => ({ tooltip: { trigger: 'item', formatter: (v: unknown) => { const r = v as {name:string;value:number}; return `${r.name}<br/>${usd(r.value, true)}`; } }, color: COLORS, series: [{ type: 'pie', radius: ['66%', '85%'], center: ['50%', '50%'], avoidLabelOverlap: true, label: { show: false }, itemStyle: { borderColor: '#10171b', borderWidth: 5, borderRadius: 3 }, data: categories().map(c => ({ name: c.name, value: c.volume })) }] })}/><div class="donut-center"><small>24H VOLUME</small><strong>{usd(overview.data()?.volume24h, true)}</strong><span>{categories().length} categories</span></div></div><div class="category-legend"><For each={categories()}>{(c, i) => <div><span class="legend-dot" style={{ background: COLORS[i() % COLORS.length] }}/><span>{c.name}<small>{c.markets} markets</small></span><strong class="mono">{usd(c.volume, true)}<small>{overview.data()?.volume24h ? `${(c.volume / overview.data()!.volume24h! * 100).toFixed(1)}%` : 'Unavailable'}</small></strong></div>}</For></div></div></Show><Source snapshot={overview.snapshot()}/></Panel>
    <Panel title="On the move" eyebrow="PRICE DISCOVERY" action={<Icon name="funding" size={18}/>} class="movers-panel"><For each={movers()} fallback={<Empty loading={overview.loading()} text="Price changes are unavailable."/>}>{m => <button class="mover-row" onClick={() => p.onMarket(m)}><Asset symbol={m.baseAsset}/><div><strong>{m.displaySymbol}</strong><small>{price(m.markPrice)} USD</small></div><Sparkline values={m.sparkline} positive={m.change24h! >= 0}/><span class={`mover-change mono ${changeClass(m.change24h)}`}>{pct(m.change24h)}<small>24h change</small></span></button>}</For><div class="insight-note"><span class="note-icon"><Icon name="system" size={17}/></span><p>Changes reflect the latest official observations. Market availability and coverage can vary.</p></div><Source snapshot={p.snapshot}/></Panel></div>
    <Panel title="Most traded markets" eyebrow="FIND YOUR NEXT MARKET" action={<button class="text-button" onClick={p.goMarkets}>Explore all markets <Icon name="arrow" size={14}/></button>}><MarketTable markets={largest()} onMarket={p.onMarket} loading={overview.loading()}/><Source snapshot={p.snapshot}/></Panel>
    <div class="product-note"><Icon name="check" size={15}/><span>Read-only market data. Paper trading is the default. Live access requires a separate wallet authorization.</span><span class="muted">Built on Polymarket Perps</span></div>
  </>;
}

function MarketsPage(p: { markets: Market[]; snapshot: Snapshot<Market[]> | null; error: string | null; loading: boolean; onMarket: (m: Market) => void }) {
  const [search, setSearch] = createSignal(''); const [category, setCategory] = createSignal('All markets'); const [sort, setSort] = createSignal('volume');
  const categories = createMemo(() => ['All markets', ...new Set(p.markets.map(m => m.category))]);
  const filtered = createMemo(() => p.markets.filter(m => (category() === 'All markets' || m.category === category()) && `${m.symbol} ${m.displaySymbol} ${m.category}`.toLowerCase().includes(search().toLowerCase())).sort((a, b) => sort() === 'name' ? a.displaySymbol.localeCompare(b.displaySymbol) : sort() === 'change' ? (b.change24h ?? -Infinity) - (a.change24h ?? -Infinity) : sort() === 'oi' ? (b.openInterestUsd ?? -1) - (a.openInterestUsd ?? -1) : (b.volume24h ?? -1) - (a.volume24h ?? -1)));
  return <><PageHeader eyebrow="EXPLORE THE EXCHANGE" title="Markets" description="Find the market. Understand its liquidity. Make your next move."><Badge>{p.markets.length} instruments</Badge></PageHeader><ErrorLine error={p.error}/><Panel><div class="screener-toolbar"><div class="filter-tabs" role="group" aria-label="Market category"><For each={categories()}>{c => <button classList={{ active: category() === c }} onClick={() => setCategory(c)}>{c}</button>}</For></div><div class="filter-actions"><label class="search-input"><Icon name="search" size={16}/><input aria-label="Search markets" placeholder="Search markets…" value={search()} onInput={e => setSearch(e.currentTarget.value)}/><kbd>/</kbd></label><select aria-label="Sort markets" value={sort()} onChange={e => setSort(e.currentTarget.value)}><option value="volume">Volume ↓</option><option value="oi">Open interest ↓</option><option value="change">24h change ↓</option><option value="name">Name A–Z</option></select></div></div><MarketTable markets={filtered()} onMarket={p.onMarket} loading={p.loading}/><div class="table-foot"><span>{filtered().length} of {p.markets.length} markets</span><span>OI notional = base quantity × mark price</span></div><Source snapshot={p.snapshot}/></Panel></>;
}

function TerminalPage(p: { market: Market | null; markets: Market[]; marketSnapshot: Snapshot<Market[]> | null; onSelect: (id: number) => void; paper: PaperAccount | null; setPaper: (account: PaperAccount) => void; reloadPaper: () => Promise<void>; paperError: string | null; liveEnabled: boolean }) {
  const [interval, setIntervalValue] = createSignal('1h');
  const [mode, setMode] = createSignal('Paper');
  const book = useSnapshot<Book>(() => `/api/book/${p.market?.id ?? 0}`, 4_000);
  const candles = useSnapshot<Candle[]>(() => `/api/candles/${p.market?.id ?? 0}?interval=${encodeURIComponent(interval())}`, 30_000);
  const trades = useSnapshot<Trade[]>(() => `/api/trades/${p.market?.id ?? 0}`, 5_000);
  const [streamBook, setStreamBook] = createSignal<Book | null>(null);
  const [streamTrades, setStreamTrades] = createSignal<Trade[]>([]);
  const [streamState, setStreamState] = createSignal('connecting');
  const [clock, setClock] = createSignal(Date.now());
  const instrumentId = createMemo(() => p.market?.id ?? null);
  onMount(() => { const timer = setInterval(() => setClock(Date.now()), 1_000); onCleanup(() => clearInterval(timer)); });
  createEffect(() => {
    const id = instrumentId(); setStreamBook(null); setStreamTrades([]);
    if (id === null) return;
    const stream = openPublicStream(id, { onBook: setStreamBook, onTrades: incoming => setStreamTrades(old => [...incoming, ...old].filter((t, i, all) => all.findIndex(x => x.id === t.id) === i).slice(0, 50)), onState: state => { setStreamState(state); if (state !== 'live') setStreamBook(null); } });
    onCleanup(() => stream.close());
  });
  const activeBook = () => streamBook() && clock() - streamBook()!.timestamp < 15_000 ? streamBook() : book.data();
  const activeBookSnapshot = (): Snapshot<Book> | null => activeBook() === streamBook() && streamBook() ? { status: 'live', data: streamBook(), source: 'wss://ws.perpetuals.polymarket.com/v1/ws', receivedAt: streamBook()!.timestamp, lastSuccessAt: streamBook()!.timestamp, error: null } : book.snapshot();
  const activeTrades = () => [...streamTrades(), ...(trades.data() ?? [])].filter((t, i, all) => all.findIndex(x => x.id === t.id) === i).sort((a, b) => b.timestamp - a.timestamp).slice(0, 12);
  const [tab, setTab] = createSignal('Positions');
  const [side, setSide] = createSignal<'buy' | 'sell'>('buy');
  const [type, setType] = createSignal<'market' | 'limit'>('market');
  const [quantity, setQuantity] = createSignal(''); const [limitPrice, setLimitPrice] = createSignal(''); const [leverage, setLeverage] = createSignal(2); const [slippage, setSlippage] = createSignal(50); const [reduceOnly, setReduceOnly] = createSignal(false); const [postOnly, setPostOnly] = createSignal(false);
  const [busy, setBusy] = createSignal(false); const [error, setError] = createSignal<string | null>(null); const [notice, setNotice] = createSignal<string | null>(null);
  const openOrders = () => p.paper?.orders.filter(o => o.status === 'open' || o.status === 'partial') ?? [];
  const quote = () => Number(quantity()) * (type() === 'limit' ? Number(limitPrice()) : p.market?.markPrice ?? 0);
  const bestBid = () => activeBook()?.bids[0] ? Number(activeBook()!.bids[0]!.price) : null;
  const bestAsk = () => activeBook()?.asks[0] ? Number(activeBook()!.asks[0]!.price) : null;
  const spread = () => bestBid() !== null && bestAsk() !== null ? bestAsk()! - bestBid()! : null;
  const ticketInput = (): OrderInput => ({ instrumentId: p.market!.id, side: side(), type: type(), quantity: quantity(), ...(type() === 'limit' ? { price: limitPrice() } : {}), leverage: leverage(), reduceOnly: reduceOnly(), postOnly: postOnly(), slippageBps: slippage(), clientOrderId: crypto.randomUUID().replaceAll('-', '') });
  const depthPreview = createMemo(() => {
    if (!quantity() || !p.market || !activeBook()) return { quote: null, error: null };
    try {
      const position = p.paper?.positions.find(position => position.instrumentId === p.market!.id)?.quantity ?? '0';
      return { quote: estimateOrder(ticketInput(), p.market, activeBook()!, position), error: null };
    } catch (e) { return { quote: null, error: (e as Error).message }; }
  });
  const place = async (e: Event) => { e.preventDefault(); setError(null); setNotice(null); if (!p.market) return; setBusy(true); try { const account = await mutate<PaperAccount>('/api/paper/orders', ticketInput()); p.setPaper(account); setNotice('Paper order processed. Review fills and resting orders below.'); } catch (e) { setError((e as Error).message); } finally { setBusy(false); } };
  const cancel = async (id: string) => { setError(null); try { p.setPaper(await mutate<PaperAccount>(`/api/paper/orders/${encodeURIComponent(id)}`, undefined, 'DELETE')); } catch (e) { setError((e as Error).message); } };
  createEffect(() => { instrumentId(); setLimitPrice(''); setError(null); setNotice(null); });
  createEffect(() => { const maximum = p.market?.maxLeverage ?? 1; setLeverage(value => Math.min(value, maximum)); });
  return <><div class="terminal-heading"><div><div class="eyebrow">EXECUTION WORKSPACE</div><h1>Trading terminal</h1></div><Segmented values={['Paper', 'Live']} value={mode()} onChange={setMode} label="Trading account mode"/></div>
    <div class={`mode-strip ${mode() === 'Live' ? 'live-mode-strip' : ''}`}><Icon name={mode() === 'Paper' ? 'check' : 'wallet'} size={16}/><strong>{mode() === 'Paper' ? 'PAPER ACCOUNT' : 'LIVE EXCHANGE ACCOUNT'}</strong><span>{mode() === 'Paper' ? 'Local simulated fills using official market data. No exchange orders are sent.' : 'Separate wallet session. Signed exchange orders require explicit review.'}</span></div>
    <ErrorLine error={p.paperError}/>
    <div class="terminal-market-header"><div class="terminal-market-select"><Asset symbol={p.market?.baseAsset ?? 'P'}/><label><span class="sr-only">Selected instrument</span><select value={p.market?.id ?? ''} onChange={e => p.onSelect(Number(e.currentTarget.value))}><For each={p.markets}>{m => <option value={m.id}>{m.displaySymbol}</option>}</For></select></label><Badge>{p.market?.maxLeverage ?? '—'}×</Badge></div><div class="selected-price mono">{price(p.market?.markPrice)}</div><div class="market-header-stat"><small>24h change</small><strong class={`mono ${changeClass(p.market?.change24h)}`}>{pct(p.market?.change24h)}</strong></div><div class="market-header-stat"><small>24h volume</small><strong class="mono">{usd(p.market?.volume24h, true)}</strong></div><div class="market-header-stat"><small>Open interest</small><strong class="mono">{usd(p.market?.openInterestUsd, true)}</strong></div><div class="market-header-stat"><small>Funding / {p.market?.fundingIntervalHours ?? '—'}h</small><strong class={`mono ${changeClass(p.market?.fundingRate)}`}>{pct(p.market?.fundingRate, 4)}</strong></div></div>
    <div class="terminal-grid"><Panel class="price-chart-panel"><div class="chart-toolbar"><span><strong>{p.market?.displaySymbol ?? 'Select a market'}</strong><span class="muted"> · Polymarket Perps</span></span><Segmented values={['1m', '5m', '15m', '1h', '4h', '1d']} value={interval()} onChange={setIntervalValue} label="Candle interval"/></div><Show when={candles.data()?.length} fallback={<Empty loading={candles.loading()} text={candles.error() ?? 'No official candles available.'}/>}><Chart height={364} label={`${p.market?.displaySymbol} official candlestick price chart`} option={() => ({ tooltip: { trigger: 'axis', axisPointer: { type: 'cross' } }, grid: [{ left: 58, right: 28, top: 25, height: '68%' }, { left: 58, right: 28, top: '79%', height: '12%' }], xAxis: [{ ...axisStyle, type: 'category', data: candles.data()!.map(c => new Date(c.timestamp).toLocaleString('en-GB', { month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit' })), boundaryGap: true, axisLabel: { show: false } }, { ...axisStyle, type: 'category', gridIndex: 1, data: candles.data()!.map(c => new Date(c.timestamp).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })), boundaryGap: true }], yAxis: [{ ...axisStyle, scale: true, position: 'right', splitNumber: 5 }, { ...axisStyle, gridIndex: 1, splitNumber: 2, axisLabel: { show: false }, splitLine: { show: false } }], dataZoom: [{ type: 'inside', xAxisIndex: [0, 1], start: Math.max(0, 100 - 60 / candles.data()!.length * 100), end: 100 }], series: [{ type: 'candlestick', data: candles.data()!.map(c => [c.open, c.close, c.low, c.high]), itemStyle: { color: '#83cdb1', color0: '#e08e8c', borderColor: '#83cdb1', borderColor0: '#e08e8c' } }, { type: 'bar', xAxisIndex: 1, yAxisIndex: 1, data: candles.data()!.map(c => ({ value: c.volume, itemStyle: { color: c.close >= c.open ? '#83cdb13b' : '#e08e8c3b' } })) }] })}/></Show><ErrorLine error={candles.error()}/><Source snapshot={candles.snapshot()} label="Official candles · volume in base units"/></Panel>
    <Panel class="orderbook-panel" title="Order book" action={<Badge tone={streamState() === 'live' ? 'mint' : ''}>{streamState() === 'live' ? 'WS LIVE' : 'REST'}</Badge>}><div class="book-labels"><span>Price (USD)</span><span>Size ({p.market?.baseAsset})</span><span>Total</span></div><BookSide levels={activeBook()?.asks.slice(0, 9).reverse() ?? []} side="ask" onPrice={v => { setLimitPrice(v); setType('limit'); }}/><div class="book-mid"><strong class={`mono ${changeClass(p.market?.change24h)}`}>{price(p.market?.markPrice)}</strong><span>Spread <b class="mono">{price(spread())}</b></span></div><BookSide levels={activeBook()?.bids.slice(0, 9) ?? []} side="bid" onPrice={v => { setLimitPrice(v); setType('limit'); }}/><Show when={!book.data()}><Empty loading={book.loading()} compact text="Book unavailable"/></Show><ErrorLine error={book.error()}/><Source snapshot={activeBookSnapshot()} label={activeBook() === streamBook() ? 'Official WebSocket · top 50' : 'Official REST fallback'}/></Panel>
    <Panel class="order-ticket"><Show when={mode() === 'Paper'} fallback={<LivePanel market={p.market} book={book.data()} enabled={p.liveEnabled} ticket={ticketInput} ticketForm={<TicketFields/>}/> }><div class="panel-heading"><h2>Place an order</h2><Badge tone="mint">PAPER</Badge></div><form onSubmit={place}><TicketFields/><div class="ticket-estimates"><div><span>Order notional</span><strong class="mono">{quote() > 0 ? usd(quote()) : '—'}</strong></div><div><span>Est. initial margin</span><strong class="mono">{quote() > 0 ? usd(quote() / leverage()) : '—'}</strong></div><div><span>Available paper margin</span><strong class="mono">{usd(p.paper?.availableMargin)}</strong></div><Show when={depthPreview().quote}>{preview => <><div class="depth-preview-label">DISPLAYED DEPTH ESTIMATE</div><div><span>Executable quantity</span><strong class="mono">{preview().filledQuantity}</strong></div><div><span>Average execution price</span><strong class="mono">{preview().averagePrice === null ? 'No fill at this limit' : price(Number(preview().averagePrice))}</strong></div><div><span>Projected slippage</span><strong class="mono">{preview().slippageBps === null ? 'Unavailable' : `${preview().slippageBps!.toFixed(2)} bps`}</strong></div><Show when={Number(preview().unfilledQuantity) > 0}><div><span>Unfilled displayed size</span><strong class="mono">{preview().unfilledQuantity}</strong></div></Show></>}</Show><Show when={depthPreview().error}><p class="preview-note">{depthPreview().error}</p></Show></div><ErrorLine error={error()}/><Show when={notice()}><div class="success-line" role="status"><Icon name="check" size={15}/>{notice()}</div></Show><button class={`button order-submit ${side() === 'sell' ? 'sell' : ''}`} type="submit" disabled={busy() || !p.market || !quantity() || !book.data() || book.snapshot()?.status !== 'live'}>{busy() ? 'Processing…' : `${side() === 'buy' ? 'Buy / Long' : 'Sell / Short'} ${p.market?.baseAsset ?? ''}`}<Icon name="arrow" size={16}/></button><p class="ticket-disclaimer">Paper fills use observed depth. Fees and margin are estimates; funding and liquidation are not simulated.</p></form></Show></Panel>
    <Panel class="account-panel"><div class="account-summary"><div><span class="eyebrow">PAPER ACCOUNT</span><strong class="mono">{usd(p.paper?.equity)}</strong><small>Account equity</small></div><div><span>Available margin</span><strong class="mono">{usd(p.paper?.availableMargin)}</strong></div><div><span>Margin used</span><strong class="mono">{usd(p.paper?.marginUsed)}</strong></div><div><span>Realized PnL · gross</span><strong class={`mono ${changeClass(p.paper?.realizedPnl)}`}>{usd(p.paper?.realizedPnl)}</strong></div><div><span>Fees paid</span><strong class="mono">{usd(p.paper?.fees)}</strong></div></div><div class="account-tabs"><Segmented values={['Positions', 'Open orders', 'Journal']} value={tab()} onChange={setTab} label="Paper account view"/><span class="small muted">Local ledger</span><button class="icon-button" onClick={() => void p.reloadPaper()} aria-label="Refresh paper account"><Icon name="refresh" size={14}/></button></div><div class="table-scroll"><Switch><Match when={tab() === 'Positions'}><table><thead><tr><th>Market</th><th>Direction / size</th><th>Entry price</th><th>Mark price</th><th>Unrealized PnL</th><th>Leverage</th></tr></thead><tbody><For each={p.paper?.positions ?? []} fallback={<tr><td colspan="6"><Empty compact text="No paper positions. Your filled orders appear here."/></td></tr>}>{position => <tr><td><strong>{position.symbol}</strong></td><td class={`mono ${Number(position.quantity) >= 0 ? 'positive' : 'negative'}`}>{Number(position.quantity) >= 0 ? 'Long' : 'Short'} {num(Math.abs(Number(position.quantity)), 8)}</td><td class="mono">{price(Number(position.entryPrice))}</td><td class="mono">{price(position.markPrice)}</td><td class={`mono ${changeClass(position.unrealizedPnl)}`}>{usd(position.unrealizedPnl)}</td><td class="mono">{position.leverage}×</td></tr>}</For></tbody></table></Match><Match when={tab() === 'Open orders'}><table><thead><tr><th>Market</th><th>Side / type</th><th>Quantity</th><th>Filled</th><th>Price</th><th>Action</th></tr></thead><tbody><For each={openOrders()} fallback={<tr><td colspan="6"><Empty compact text="No resting paper orders."/></td></tr>}>{o => <tr><td>{p.markets.find(m => m.id === o.input.instrumentId)?.displaySymbol ?? `#${o.input.instrumentId}`}</td><td class={o.input.side === 'buy' ? 'positive' : 'negative'}>{o.input.side} · {o.input.type}</td><td class="mono">{o.input.quantity}</td><td class="mono">{o.filledQuantity}</td><td class="mono">{o.input.price ?? 'Market'}</td><td><button class="text-button danger-text" onClick={() => void cancel(o.id)}>Cancel</button></td></tr>}</For></tbody></table></Match><Match when={tab() === 'Journal'}><table><thead><tr><th>Time</th><th>Action</th><th>Instrument</th><th>Execution detail</th></tr></thead><tbody><For each={p.paper?.journal.slice(0, 40) ?? []} fallback={<tr><td colspan="4"><Empty compact text="Your paper execution audit appears here."/></td></tr>}>{row => <tr><td class="mono muted">{stamp(row.timestamp)}</td><td><Badge>{row.action}</Badge></td><td>{p.markets.find(m => m.id === row.instrumentId)?.displaySymbol ?? 'Account'}</td><td class="journal-detail">{row.detail}</td></tr>}</For></tbody></table></Match></Switch></div></Panel>
    <Panel class="trade-tape-panel" title="Recent trades" action={<span class="small muted">Official tape</span>}><div class="trade-tape-labels"><span>Price (USD)</span><span>Size</span><span>Time</span></div><For each={activeTrades()} fallback={<Empty compact loading={trades.loading()} text="No recent trades available."/>}>{t => <div class="trade-tape-row"><span class={`mono ${t.side.toLowerCase() === 'buy' || t.side === 'bid' || t.side === 'long' ? 'positive' : 'negative'}`}>{price(t.price)}</span><span class="mono">{num(t.quantity, 5)}</span><span class="mono muted">{stamp(t.timestamp)}</span></div>}</For><Source snapshot={trades.snapshot()}/></Panel></div>
  </>;
  function TicketFields() { return <><div class="side-toggle" role="group" aria-label="Order side"><button type="button" classList={{ active: side() === 'buy', buy: true }} onClick={() => setSide('buy')}>Buy / Long</button><button type="button" classList={{ active: side() === 'sell', sell: true }} onClick={() => setSide('sell')}>Sell / Short</button></div><div class="order-type-tabs"><button type="button" classList={{ active: type() === 'market' }} onClick={() => { setType('market'); setPostOnly(false); }}>Market</button><button type="button" classList={{ active: type() === 'limit' }} onClick={() => setType('limit')}>Limit</button><span>IOC / GTC</span></div><label class="field-label">Quantity<div class="input-with-unit"><input required inputmode="decimal" placeholder="0.00" value={quantity()} onInput={e => setQuantity(e.currentTarget.value)} aria-label="Order quantity"/><span>{p.market?.baseAsset ?? 'BASE'}</span></div></label><Show when={type() === 'limit'}><label class="field-label">Limit price<div class="input-with-unit"><input required inputmode="decimal" placeholder={String(p.market?.markPrice ?? '')} value={limitPrice()} onInput={e => setLimitPrice(e.currentTarget.value)} aria-label="Limit price"/><span>USD</span></div></label></Show><div class="leverage-row"><label for="leverage">Leverage <strong class="mono">{leverage()}×</strong></label><input id="leverage" type="range" min="1" max={Math.max(1, p.market?.maxLeverage ?? 1)} step="1" value={leverage()} onInput={e => setLeverage(Number(e.currentTarget.value))}/><div><span>1×</span><span>{p.market?.maxLeverage ?? 1}×</span></div></div><label class="field-label inline-field">Slippage bound<select aria-label="Slippage bound" value={slippage()} onChange={e => setSlippage(Number(e.currentTarget.value))}><option value="10">0.10%</option><option value="25">0.25%</option><option value="50">0.50%</option><option value="100">1.00%</option></select></label><div class="ticket-checkboxes"><label><input type="checkbox" checked={reduceOnly()} onChange={e => setReduceOnly(e.currentTarget.checked)}/>Reduce only</label><label><input type="checkbox" checked={postOnly()} disabled={type() === 'market'} onChange={e => setPostOnly(e.currentTarget.checked)}/>Post only</label></div></>; }
}

function BookSide(p: { levels: { price: string; quantity: string }[]; side: 'ask' | 'bid'; onPrice: (s: string) => void }) { const max = () => Math.max(...p.levels.map(l => Number(l.quantity)), 1); return <div class={`book-side ${p.side}`}><For each={p.levels}>{l => <button class="book-row" onClick={() => p.onPrice(l.price)} title="Use this limit price"><i style={{ width: `${Number(l.quantity) / max() * 100}%` }}/><span class="mono">{price(Number(l.price))}</span><span class="mono">{num(Number(l.quantity), 5)}</span><span class="mono muted">{num(Number(l.quantity) * Number(l.price), 0)}</span></button>}</For></div>; }

function FundingPage(p: { markets: Market[]; snapshot: Snapshot<Market[]> | null; onMarket: (m: Market) => void }) {
  const [selected, setSelected] = createSignal<number | null>(null); const [sort, setSort] = createSignal('Highest APR');
  const market = () => p.markets.find(m => m.id === selected()) ?? p.markets.find(m => m.baseAsset === 'BTC') ?? p.markets[0] ?? null;
  const history = useSnapshot<FundingPoint[]>(() => `/api/funding/${market()?.id ?? 0}`, 30_000);
  const ranked = createMemo(() => [...p.markets].sort((a, b) => sort() === 'Lowest APR' ? (a.fundingApr ?? Infinity) - (b.fundingApr ?? Infinity) : (b.fundingApr ?? -Infinity) - (a.fundingApr ?? -Infinity)));
  const observed = () => p.markets.filter(m => m.fundingRate !== null);
  return <><PageHeader eyebrow="THE COST OF CONVICTION" title="Funding intelligence" description="Compare the current cost of holding a position across every market."><Badge tone="mint">Official funding observations</Badge></PageHeader><div class="funding-note"><Icon name="alert" size={17}/><span>Annualized rates are simple extrapolations of the current interval rate. They are not a forecast or guaranteed yield.</span></div><div class="stats-grid three-stats"><StatCard label="MARKETS REPORTING" value={`${observed().length} / ${p.markets.length}`} detail="Current funding observations" icon="system"/><StatCard label="POSITIVE FUNDING" value={String(observed().filter(m => m.fundingRate! > 0).length)} detail="Longs pay shorts under venue convention" icon="funding"/><StatCard label="NEGATIVE FUNDING" value={String(observed().filter(m => m.fundingRate! < 0).length)} detail="Shorts pay longs under venue convention" icon="funding"/></div><Panel title="Funding history" eyebrow="SETTLEMENT OBSERVATIONS" action={<select aria-label="Funding history market" value={market()?.id} onChange={e => setSelected(Number(e.currentTarget.value))}><For each={p.markets}>{m => <option value={m.id}>{m.displaySymbol}</option>}</For></select>}><Show when={history.data()?.length} fallback={<Empty loading={history.loading()} text={history.error() ?? 'Funding history is unavailable for this instrument.'}/>}><Chart height={270} label="Official historical funding observations" option={() => ({ grid: chartGrid, tooltip: { trigger: 'axis', valueFormatter: v => `${(Number(v) * 100).toFixed(5)}%` }, xAxis: { ...axisStyle, type: 'category', data: history.data()!.map(x => new Date(x.timestamp).toLocaleDateString('en-GB', { month: 'short', day: '2-digit', hour: '2-digit' })) }, yAxis: { ...axisStyle, type: 'value', axisLabel: { formatter: (v: number) => `${(v * 100).toFixed(3)}%`, color: '#738086', fontSize: 10 } }, series: [{ type: 'bar', barMaxWidth: 15, data: history.data()!.map(x => ({ value: x.rate, itemStyle: { color: x.rate >= 0 ? '#a5d68a' : '#d98b8a' } })) }] })}/></Show><Source snapshot={history.snapshot()}/></Panel><Panel title="Funding rates" eyebrow="RANK THE MARKET" action={<select aria-label="Sort funding" value={sort()} onChange={e => setSort(e.currentTarget.value)}><option>Highest APR</option><option>Lowest APR</option></select>}><div class="table-scroll"><table><thead><tr><th>Instrument</th><th>Current rate</th><th>Interval</th><th>Annualized · simple</th><th>Next settlement</th><th>Open interest</th><th/></tr></thead><tbody><For each={ranked()}>{m => <tr><td><div class="market-name"><Asset symbol={m.baseAsset} small/><strong>{m.displaySymbol}</strong></div></td><td class={`mono ${changeClass(m.fundingRate)}`}>{pct(m.fundingRate, 5)}</td><td class="mono">{m.fundingIntervalHours === null ? 'Unavailable' : `${m.fundingIntervalHours}h`}</td><td class={`mono ${changeClass(m.fundingApr)}`}>{pct(m.fundingApr)}</td><td class="mono">{m.nextFunding ? new Date(m.nextFunding).toLocaleString('en-GB', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: 'short' }) : 'Unavailable'}</td><td class="mono">{usd(m.openInterestUsd, true)}</td><td><button class="text-button" onClick={() => p.onMarket(m)}>Trade <Icon name="arrow" size={13}/></button></td></tr>}</For></tbody></table></div><Source snapshot={p.snapshot}/></Panel></>;
}

function LeaderboardPage() {
  const [window, setWindow] = createSignal('week'); const [sort, setSort] = createSignal('pnl'); const [search, setSearch] = createSignal('');
  const board = useSnapshot<Leaderboard>(() => `/api/leaderboard?window=${window()}&sort=${sort()}`, 60_000);
  const rows = () => board.data()?.entries.filter(r => r.account.toLowerCase().includes(search().toLowerCase())) ?? [];
  return <><PageHeader eyebrow="PERFORMANCE, IN PERSPECTIVE" title="Trader leaderboard" description="Explore official trader rankings with clear calendar windows and coverage."><Badge>Official ranking</Badge></PageHeader><div class="funding-note"><Icon name="clock" size={16}/><span>Day, week and month are exchange-defined calendar windows. The visible rows are the returned ranking, not all exchange accounts.</span></div><Panel><div class="screener-toolbar"><Segmented values={['day', 'week', 'month', 'all']} value={window()} onChange={setWindow} label="Leaderboard calendar window"/><div class="filter-actions"><label class="search-input"><Icon name="search" size={15}/><input placeholder="Find an account…" aria-label="Find leaderboard account" value={search()} onInput={e => setSearch(e.currentTarget.value)}/></label><select aria-label="Leaderboard sort metric" value={sort()} onChange={e => setSort(e.currentTarget.value)}><option value="pnl">PnL ↓</option><option value="notional">Notional ↓</option><option value="account_value">Account value ↓</option></select></div></div><ErrorLine error={board.error()}/><div class="table-scroll"><table class="leaderboard-table"><thead><tr><th>Rank</th><th>Trader account</th><th>Profit & loss</th><th>Trading notional</th><th>Account value</th><th>ROI</th></tr></thead><tbody><For each={rows()} fallback={<tr><td colspan="6"><Empty loading={board.loading()} text="No official ranking rows available for this view."/></td></tr>}>{r => <tr><td><span class={`rank-badge rank-${r.rank}`}>{String(r.rank).padStart(2, '0')}</span></td><td><span class="trader-avatar">{r.account.slice(-2).toUpperCase()}</span><span class="mono" title={r.account}>{shortAddress(r.account)}</span></td><td class={`mono ${changeClass(r.pnl)}`}>{usd(r.pnl)}</td><td class="mono">{usd(r.notional, true)}</td><td class="mono">{usd(r.accountValue, true)}</td><td class={`mono ${changeClass(r.roi)}`}>{pct(r.roi)}</td></tr>}</For></tbody></table></div><div class="table-foot"><span>{rows().length} visible rows · {board.data()?.total ?? 'Unavailable'} reported total</span><span>Window: {board.data()?.window ?? window()}</span></div><Source snapshot={board.snapshot()}/></Panel></>;
}

function BotsPage(p: { markets: Market[]; paper: PaperAccount | null; setPaper: (account: PaperAccount) => void }) {
  const [bots, setBots] = createSignal<BotState[]>([]); const [error, setError] = createSignal<string | null>(null); const [notice, setNotice] = createSignal<string | null>(null); const [busy, setBusy] = createSignal(false); const [confirmReset, setConfirmReset] = createSignal(false);
  const [strategy, setStrategy] = createSignal<'twap'|'maker'>('twap'); const [id, setId] = createSignal<number | null>(null); const [side, setSide] = createSignal<'buy'|'sell'>('buy'); const [quantity, setQuantity] = createSignal(''); const [slices, setSlices] = createSignal(5); const [seconds, setSeconds] = createSignal(30); const [spread, setSpread] = createSignal(10); const [leverage, setLeverage] = createSignal(1);
  const load = async () => { try { setBots(await request<BotState[]>('/api/bots')); setError(null); } catch (e) { setError((e as Error).message); } };
  onMount(() => { void load(); const timer = setInterval(() => { void load(); }, 5_000); onCleanup(() => clearInterval(timer)); });
  const act = async (action: () => Promise<void>) => { setBusy(true); setError(null); try { await action(); } catch (e) { setError((e as Error).message); } finally { setBusy(false); } };
  const create = (event: Event) => { event.preventDefault(); void act(async () => { const cfg: BotConfig = { instrumentId: id() ?? p.markets[0]?.id ?? 0, strategy: strategy(), side: side(), totalQuantity: quantity(), slices: slices(), intervalSeconds: seconds(), spreadBps: spread(), leverage: leverage() }; await mutate<BotState>('/api/bots', cfg); await load(); setNotice('Paper automation started. Its activity is recorded in the local journal.'); }); };
  return <><PageHeader eyebrow="DISCIPLINED EXECUTION" title="Automations" description="Run bounded paper strategies on live observations. Stay in control."><button class="button danger" disabled={busy() || !bots().some(b => b.status === 'running')} onClick={() => void act(async () => { setBots(await mutate<BotState[]>('/api/bots/kill', {})); setNotice('All paper automations stopped. Review remaining paper orders in the terminal.'); })}><Icon name="stop" size={15}/>Kill all strategies</button></PageHeader><div class="mode-strip"><Icon name="check" size={16}/><strong>PAPER STRATEGIES ONLY</strong><span>Automation has no upstream write access. It uses the local paper ledger.</span></div><ErrorLine error={error()}/><Show when={notice()}><div class="success-line" role="status">{notice()}</div></Show><div class="automation-layout"><Panel title="Create a strategy" eyebrow="EXECUTION PLAYBOOK" class="strategy-form-panel"><form onSubmit={create}><div class="strategy-choice"><button type="button" classList={{ selected: strategy() === 'twap' }} onClick={() => setStrategy('twap')}><Icon name="clock" size={24}/><strong>TWAP</strong><small>Split an order over time</small></button><button type="button" classList={{ selected: strategy() === 'maker' }} onClick={() => setStrategy('maker')}><Icon name="markets" size={24}/><strong>Maker</strong><small>Quote near the market</small></button></div><div class="form-grid"><label class="field-label">Instrument<select value={id() ?? p.markets[0]?.id} onChange={e => setId(Number(e.currentTarget.value))}><For each={p.markets}>{m => <option value={m.id}>{m.displaySymbol}</option>}</For></select></label><label class="field-label">Side<select value={side()} onChange={e => setSide(e.currentTarget.value as 'buy'|'sell')}><option value="buy">Buy / Long</option><option value="sell">Sell / Short</option></select></label><label class="field-label">Total base quantity<input required inputmode="decimal" placeholder="0.00" value={quantity()} onInput={e => setQuantity(e.currentTarget.value)}/></label><label class="field-label">Slices / maximum ticks<input type="number" required min="1" max="100" value={slices()} onInput={e => setSlices(Number(e.currentTarget.value))}/></label><label class="field-label">Interval (seconds)<input type="number" required min="5" max="3600" value={seconds()} onInput={e => setSeconds(Number(e.currentTarget.value))}/></label><label class="field-label">Quote spread (bps)<input type="number" required min="1" max="500" value={spread()} onInput={e => setSpread(Number(e.currentTarget.value))}/></label><label class="field-label">Leverage<input type="number" required min="1" max={p.markets.find(m => m.id === (id() ?? p.markets[0]?.id))?.maxLeverage ?? 1} value={leverage()} onInput={e => setLeverage(Number(e.currentTarget.value))}/></label></div><button type="submit" class="button primary full-width" disabled={busy() || !quantity() || !p.markets.length}><Icon name="play" size={15}/>{busy() ? 'Starting…' : 'Start paper strategy'}</button><p class="ticket-disclaimer">Strategies halt on stale books, invalid metadata or a failed safety check. The server validates notional and margin.</p></form></Panel><Panel title="Strategy sessions" eyebrow="LOCAL OPERATIONS" action={<Badge>{bots().filter(b => b.status === 'running').length} running</Badge>}><For each={bots()} fallback={<div class="automation-empty"><div class="automation-empty-icon"><Icon name="bots" size={34}/></div><h3>Your next strategy starts here</h3><p>Create a paper TWAP or maker session. Track its progress, decisions and execution without sending an exchange order.</p></div>}>{bot => <div class="bot-card"><div class="bot-card-head"><div><span class="bot-icon"><Icon name={bot.config.strategy === 'twap' ? 'clock' : 'markets'}/></span><strong>{bot.config.strategy.toUpperCase()}<small>{p.markets.find(m => m.id === bot.config.instrumentId)?.displaySymbol ?? `#${bot.config.instrumentId}`} · {bot.config.side}</small></strong></div><Badge tone={bot.status === 'running' ? 'mint' : bot.status === 'halted' ? 'red' : ''}>{bot.status}</Badge></div><div class="bot-progress"><i style={{ width: `${Math.min(100, bot.ticks / bot.config.slices * 100)}%` }}/></div><div class="bot-details"><span>{bot.ticks} / {bot.config.slices} ticks</span><span class="mono">{bot.config.totalQuantity} base</span><span>Every {bot.config.intervalSeconds}s</span></div><p class="small muted">{bot.note}</p><Show when={bot.status === 'running'}><button class="button subtle small-button" disabled={busy()} onClick={() => void act(async () => { await mutate<BotState>(`/api/bots/${bot.id}/stop`, {}); await load(); })}><Icon name="stop" size={13}/>Stop strategy</button></Show></div>}</For></Panel></div><Panel title="Paper ledger" action={<Badge>Local only</Badge>}><div class="ledger-settings"><div><strong>{usd(p.paper?.equity)} paper equity</strong><p>Resetting clears paper positions and orders; the audit journal is retained. Stop active strategies first.</p></div><Show when={confirmReset()} fallback={<button class="button subtle" onClick={() => setConfirmReset(true)}>Reset paper account</button>}><div class="reset-confirm"><span>Reset paper positions and orders?</span><button class="button danger" disabled={busy() || bots().some(b => b.status === 'running')} onClick={() => void act(async () => { p.setPaper(await mutate<PaperAccount>('/api/paper/reset', {})); setConfirmReset(false); setNotice('Paper account reset.'); })}>Confirm reset</button><button class="button subtle" onClick={() => setConfirmReset(false)}>Keep account</button></div></Show></div></Panel></>;
}

function SystemPage(p: { health: Health | null; error: string | null; marketSnapshot: Snapshot<Market[]> | null; refresh: () => void }) {
  return <><PageHeader eyebrow="TRUST THE OBSERVATION" title="System & sources" description="An honest view of connectivity, data definitions and execution boundaries."><button class="button subtle" onClick={p.refresh}><Icon name="refresh" size={15}/>Refresh checks</button></PageHeader><ErrorLine error={p.error}/><div class="system-grid"><Panel title="Workspace status" eyebrow="LOCAL SERVICE"><div class="system-list"><div><span>API service</span><Badge tone={p.health ? 'mint' : 'red'}>{p.health ? 'Connected' : 'Unavailable'}</Badge></div><div><span>Market snapshot</span><Badge tone={p.marketSnapshot?.status === 'live' ? 'mint' : ''}>{p.marketSnapshot?.status ?? 'Unavailable'}</Badge></div><div><span>Last market success</span><strong class="mono">{stamp(p.marketSnapshot?.lastSuccessAt)}</strong></div><div><span>Exchange data</span><strong>Polymarket Perps</strong></div><div><span>Storage</span><strong>{p.health?.database ?? 'Unavailable'}</strong></div><div><span>Live order relay</span><Badge tone={p.health?.liveEnabled ? 'mint' : ''}>{p.health?.liveEnabled ? 'Explicitly enabled' : 'Disabled by default'}</Badge></div></div><ErrorLine error={p.marketSnapshot?.error}/><Source snapshot={p.marketSnapshot}/></Panel><Panel title="Execution boundaries" eyebrow="YOUR KEYS, YOUR SESSION"><div class="boundary-item"><span class="boundary-icon"><Icon name="check"/></span><div><h3>Paper account</h3><p>Locally persisted simulated orders, positions and strategy activity. No exchange write access.</p></div></div><div class="boundary-item"><span class="boundary-icon"><Icon name="wallet"/></span><div><h3>Live account</h3><p>An injected EVM wallet authorizes an expiring proxy. Browser credentials stay in memory. Every financial write is sent once.</p></div></div><div class="boundary-item"><span class="boundary-icon"><Icon name="alert"/></span><div><h3>Unknown outcomes halt execution</h3><p>A lost response may still mean an accepted order. Reconciliation must finish before another live action.</p></div></div></Panel></div><Panel title="Metric definitions" eyebrow="SOURCE METHODOLOGY"><div class="table-scroll"><table class="definition-table"><thead><tr><th>Metric</th><th>Definition & coverage</th><th>Source</th></tr></thead><tbody><tr><td>24h trading volume</td><td>Official statistics quote volume. Totals include reporting markets; missing values remain unavailable.</td><td>Instrument statistics</td></tr><tr><td>Open interest USD</td><td>One-sided base open interest multiplied by the current mark. A derived USD conversion.</td><td>Ticker + mark price</td></tr><tr><td>Funding APR</td><td>Interval funding × (24 / interval hours) × 365. Simple extrapolation, without compounding.</td><td>Instrument funding interval</td></tr><tr><td>Candlestick volume</td><td>Base asset quantity from official candles, displayed separately from quote trading volume.</td><td>Candle endpoint</td></tr><tr><td>Trader rankings</td><td>Returned official ranking for the selected exchange calendar window. Does not represent a global account census.</td><td>Official leaderboard</td></tr><tr><td>Paper PnL</td><td>Local position and fill accounting using observed venue liquidity. Separate from the exchange account.</td><td>Local paper ledger</td></tr></tbody></table></div></Panel><div class="source-cards"><a href="https://docs.polymarket.com/perps/overview" target="_blank" rel="noreferrer"><Icon name="link"/><div><strong>Perps documentation</strong><small>Architecture, market data and trading</small></div><Icon name="arrow"/></a><a href="https://api.perpetuals.polymarket.com" target="_blank" rel="noreferrer"><Icon name="system"/><div><strong>Official REST API</strong><small>api.perpetuals.polymarket.com</small></div><Icon name="arrow"/></a></div></>;
}
