# Copy to quoter/.env (gitignored). Only these keys are accepted from the file.
# Egress HTTP proxies for every REST and WebSocket call: label=host:port:user:pass, comma-separated.
QUOTER_EGRESS_PROXIES=de1=203.0.113.10:8080:user:pass,pl=203.0.113.20:8080:user:pass
# QUOTER_CONFIG=config/quoter.yaml
# QUOTER_LOG_LEVEL=info

# Wallet / Polymarket proxy keys are refused here. Export them in the shell for the process lifetime:
#   PERPS_OWNER_PRIVATE_KEY=0x...          registers a fresh expiring proxy at startup (memory only)
# or an already registered proxy:
#   PERPS_PROXY_PRIVATE_KEY=0x...  PERPS_PROXY_SECRET=...  PERPS_PROXY_EXPIRES_AT=<unix ms>
